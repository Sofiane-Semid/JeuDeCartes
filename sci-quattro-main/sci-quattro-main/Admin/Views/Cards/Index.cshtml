@model IEnumerable<Models.Models.Card>

@{
    ViewData["Title"] = "Index";
}

<h1>Cartes</h1>

<p>
    <a asp-action="Create">Créer une carte</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attack)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Health)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.rarete)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(Model=>Model.CardPowers)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Attack)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Health)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cost)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.rarete)
                </td>
            <td>
                    <img src="@item.ImageUrl" alt="@item.Name" width=300 />
            </td>
                <td>
                    @foreach (CardPower power in item.CardPowers)
                    {
                        <t>@power.Power.Name @power.Value</t>
                        
                        
                    }
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a> |
                
                <a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>
            </td>
        </tr>
}
    </tbody>
</table>
